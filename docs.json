{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "BounceWatch API",
  "colors": {
    "primary": "#2c7be5",
    "light": "#6586FF",
    "dark": "#0D193A"
  },
  "favicon": "/favicon.png",
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": ["curl", "javascript", "python", "php"],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "credits-and-modules",
          "rate-limits",
          "webhooks"
        ]
      },
      {
        "group": "AI Agents (MCP)",
        "pages": [
          "mcp/overview",
          "mcp/setup",
          "mcp/tools"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/overview",
          "api-reference/response-schema",
          "api-reference/company-api",
          "api-reference/enrichment-tracking",
          "api-reference/account"
        ]
      },
      {
        "group": "API Playground",
        "openapi": "openapi.json",
        "pages": [
          "GET /company/{domain}",
          "GET /enrichment/{batch_id}/status",
          "GET /enrichment/{batch_id}/results",
          "GET /account/info",
          "GET /account/credits",
          "GET /account/usage",
          "GET /account/history",
          "POST /account/webhook"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/bounce-logo-dark.png",
    "dark": "/logo/bounce-logo-white.png"
  },
  "navbar": {
    "links": [
      {
        "label": "FAQ",
        "href": "/faq"
      },
      {
        "label": "Support",
        "href": "mailto:sedat@bouncewatch.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://bouncewatch.com/api-panel/api-keys"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://bouncewatch.com",
      "linkedin": "https://www.linkedin.com/company/bounce-watch"
    }
  }
}
